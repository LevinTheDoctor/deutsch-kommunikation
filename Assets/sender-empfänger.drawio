<mxfile host="app.diagrams.net">
  <diagram id="kommunikationsmodell" name="Kommunikationsmodell">
    <mxGraphModel dx="1300" dy="600" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="500" math="0" shadow="0">
      <root>
        <!-- Pflicht-Zellen: id 0 = unsichtbare Wurzel, id 1 = Standard-Ebene (Layer). -->
        <!-- Jedes sichtbare Element hängt per parent="1" (oder an einer Gruppe) darunter. -->
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= RAHMEN "SITUATION" ================= -->
        <!-- Zwei offene Linienzüge (edge) statt eines Rechtecks: so bleibt oben und unten -->
        <!-- eine echte Lücke für das Wort "Situation", unabhängig von Hell-/Dunkelmodus. -->
        <!-- sourcePoint = Startpunkt, targetPoint = Endpunkt, Array/points = Knickpunkte. -->
        <mxCell id="rahmen-links" style="endArrow=none;html=1;rounded=0;strokeColor=#808080;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="35" as="sourcePoint" />
            <mxPoint x="430" y="455" as="targetPoint" />
            <Array as="points">
              <mxPoint x="25" y="35" />
              <mxPoint x="25" y="455" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rahmen-rechts" style="endArrow=none;html=1;rounded=0;strokeColor=#808080;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="35" as="sourcePoint" />
            <mxPoint x="750" y="455" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1130" y="35" />
              <mxPoint x="1130" y="455" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Beschriftungen in den Rahmen-Lücken; fontStyle=1 bedeutet fett. -->
        <mxCell id="situation-oben" value="Situation" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="22" width="100" height="26" as="geometry" />
        </mxCell>
        <mxCell id="situation-unten" value="Situation" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="442" width="100" height="26" as="geometry" />
        </mxCell>

        <!-- ================= BLOCKPFEILE ================= -->
        <!-- shape=singleArrow: arrowWidth = Schaftdicke als Anteil der Höhe (80/165 = 0.485), -->
        <!-- arrowSize = Länge der Spitze als Anteil der Breite (85/635 = 0.134). -->
        <!-- spacingRight=40 schiebt den zentrierten Text nach links, weg von der Spitze. -->
        <!-- &lt;br&gt; ist ein escaptes <br>, weil html=1 den value als HTML rendert. -->
        <mxCell id="pfeil-verbal" value="über natürliche Kanäle: gesprochene Worte&lt;br&gt;über technische Kanäle: geschriebene Worte" style="shape=singleArrow;whiteSpace=wrap;html=1;arrowWidth=0.485;arrowSize=0.134;fillColor=#4F81BD;strokeColor=#385D8A;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;spacingRight=40;" vertex="1" parent="1">
          <mxGeometry x="270" y="125" width="635" height="165" as="geometry" />
        </mxCell>
        <mxCell id="titel-verbal" value="verbale Informationen" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="400" y="133" width="240" height="26" as="geometry" />
        </mxCell>

        <mxCell id="pfeil-nonverbal" value="über natürliche Kanäle: Mimik, Gestik, Kleidung&lt;br&gt;über techn. Kanäle: Smileys, Sound-/Aktionswörter" style="shape=singleArrow;whiteSpace=wrap;html=1;arrowWidth=0.485;arrowSize=0.134;fillColor=#4F81BD;strokeColor=#385D8A;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;spacingRight=40;" vertex="1" parent="1">
          <mxGeometry x="270" y="290" width="635" height="165" as="geometry" />
        </mxCell>
        <mxCell id="titel-nonverbal" value="nonverbale Informationen" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="390" y="292" width="270" height="26" as="geometry" />
        </mxCell>

        <!-- ================= SENDER ================= -->
        <!-- style="group": unsichtbarer Container, alle Kinder (parent="sender") bewegen sich gemeinsam. -->
        <!-- Koordinaten der Kinder sind RELATIV zur linken oberen Ecke der Gruppe (100|175). -->
        <mxCell id="sender" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="100" y="175" width="160" height="262" as="geometry" />
        </mxCell>
        <!-- Gliedmaßen = Linien ohne Pfeilspitze (endArrow=none), strokeWidth=10 für die dicken Striche. -->
        <!-- Reihenfolge im XML = Zeichenreihenfolge: Linien zuerst, Kopf danach liegt oben drauf. -->
        <mxCell id="sender-koerper" style="endArrow=none;html=1;rounded=0;strokeWidth=10;strokeColor=#4F81BD;" edge="1" parent="sender">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="86" y="77" as="sourcePoint" />
            <mxPoint x="86" y="170" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Arme des Senders zeigen schräg nach unten. -->
        <mxCell id="sender-arm-links" style="endArrow=none;html=1;rounded=0;strokeWidth=10;strokeColor=#4F81BD;" edge="1" parent="sender">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="86" y="117" as="sourcePoint" />
            <mxPoint x="6" y="155" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sender-arm-rechts" style="endArrow=none;html=1;rounded=0;strokeWidth=10;strokeColor=#4F81BD;" edge="1" parent="sender">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="86" y="117" as="sourcePoint" />
            <mxPoint x="156" y="147" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sender-bein-links" style="endArrow=none;html=1;rounded=0;strokeWidth=10;strokeColor=#4F81BD;" edge="1" parent="sender">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="86" y="170" as="sourcePoint" />
            <mxPoint x="32" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sender-bein-rechts" style="endArrow=none;html=1;rounded=0;strokeWidth=10;strokeColor=#4F81BD;" edge="1" parent="sender">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="86" y="170" as="sourcePoint" />
            <mxPoint x="140" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Kopf: Ellipse, Mittelpunkt x = 40 + 92/2 = 86, genau über dem Körper. -->
        <mxCell id="sender-kopf" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4F81BD;strokeColor=#385D8A;strokeWidth=2;" vertex="1" parent="sender">
          <mxGeometry x="40" y="3" width="92" height="74" as="geometry" />
        </mxCell>
        <mxCell id="sender-name" value="Sender" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="sender">
          <mxGeometry x="36" y="232" width="100" height="30" as="geometry" />
        </mxCell>

        <!-- Gedankenblase des Senders: shape=cloud plus zwei kleine Ellipsen als "Denk-Bläschen". -->
        <mxCell id="gedanke-sender" value="Intention" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#4F81BD;strokeColor=#385D8A;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="95" y="60" width="255" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gedanke-sender-blase-gross" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4F81BD;strokeColor=#385D8A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="170" y="148" width="20" height="15" as="geometry" />
        </mxCell>
        <mxCell id="gedanke-sender-blase-klein" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4F81BD;strokeColor=#385D8A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="178" y="164" width="10" height="8" as="geometry" />
        </mxCell>

        <!-- ================= EMPFÄNGER ================= -->
        <!-- Gleicher Aufbau wie beim Sender, Gruppen-Ursprung (920|160), Körperachse bei x = 80. -->
        <mxCell id="empfaenger" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="920" y="160" width="170" height="295" as="geometry" />
        </mxCell>
        <mxCell id="empfaenger-koerper" style="endArrow=none;html=1;rounded=0;strokeWidth=10;strokeColor=#4F81BD;" edge="1" parent="empfaenger">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="77" as="sourcePoint" />
            <mxPoint x="80" y="172" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Arme des Empfängers zeigen schräg nach oben (Ziel-y kleiner als Start-y). -->
        <mxCell id="empfaenger-arm-links" style="endArrow=none;html=1;rounded=0;strokeWidth=10;strokeColor=#4F81BD;" edge="1" parent="empfaenger">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="115" as="sourcePoint" />
            <mxPoint x="8" y="72" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="empfaenger-arm-rechts" style="endArrow=none;html=1;rounded=0;strokeWidth=10;strokeColor=#4F81BD;" edge="1" parent="empfaenger">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="115" as="sourcePoint" />
            <mxPoint x="156" y="74" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="empfaenger-bein-links" style="endArrow=none;html=1;rounded=0;strokeWidth=10;strokeColor=#4F81BD;" edge="1" parent="empfaenger">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="172" as="sourcePoint" />
            <mxPoint x="26" y="235" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="empfaenger-bein-rechts" style="endArrow=none;html=1;rounded=0;strokeWidth=10;strokeColor=#4F81BD;" edge="1" parent="empfaenger">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="172" as="sourcePoint" />
            <mxPoint x="138" y="235" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="empfaenger-kopf" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4F81BD;strokeColor=#385D8A;strokeWidth=2;" vertex="1" parent="empfaenger">
          <mxGeometry x="32" y="5" width="96" height="72" as="geometry" />
        </mxCell>
        <mxCell id="empfaenger-name" value="Empfänger" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="empfaenger">
          <mxGeometry x="25" y="265" width="110" height="30" as="geometry" />
        </mxCell>

        <mxCell id="gedanke-empfaenger" value="Entschlüsselung" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#4F81BD;strokeColor=#385D8A;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="875" y="40" width="340" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gedanke-empfaenger-blase-gross" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4F81BD;strokeColor=#385D8A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="980" y="128" width="20" height="15" as="geometry" />
        </mxCell>
        <mxCell id="gedanke-empfaenger-blase-klein" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4F81BD;strokeColor=#385D8A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="988" y="145" width="10" height="8" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
